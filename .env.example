# Universal Forensic Toolkit Configuration
# Copy this file to .env and customize for your case

# Case Information (REQUIRED)
FORENSIC_CASE_ID=CASE-2026-001
FORENSIC_CASE_NAME="Investigation Case Example"
FORENSIC_INVESTIGATOR="John Doe"

# Workspace Paths (customize for your environment)
# All paths are relative to FORENSIC_WORKSPACE_ROOT if not absolute
FORENSIC_WORKSPACE_ROOT=/path/to/case/workspace
FORENSIC_EVIDENCE_PATH=${FORENSIC_WORKSPACE_ROOT}/evidence
FORENSIC_OUTPUT_PATH=${FORENSIC_WORKSPACE_ROOT}/output
FORENSIC_TEMP_PATH=${FORENSIC_WORKSPACE_ROOT}/temp
FORENSIC_LOGS_PATH=${FORENSIC_WORKSPACE_ROOT}/logs
FORENSIC_REPORTS_PATH=${FORENSIC_WORKSPACE_ROOT}/reports

# Forensic Standards
FORENSIC_AUDIT_TRAIL=true
FORENSIC_HASH_VERIFICATION=true
FORENSIC_HASH_ALGORITHM=sha256

# AI-Assisted Analysis (optional)
FORENSIC_AI_ENABLED=false
FORENSIC_AI_PROVIDER=openai
FORENSIC_AI_API_KEY=your-api-key-here
FORENSIC_AI_MODEL=gpt-4

# Processing Options
FORENSIC_PARALLEL_PROCESSING=true
FORENSIC_MAX_WORKERS=4
FORENSIC_VERBOSE_LOGGING=false
